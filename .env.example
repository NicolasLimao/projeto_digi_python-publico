# Runtime
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Protect every /api/* route. Required when ENVIRONMENT=production.
API_AUTH_TOKEN=replace-with-a-long-random-token

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# Candidate pool before reranking; 1–60, at least max_chunks at runtime.
RETRIEVAL_CANDIDATE_COUNT=30

# Supabase — service role is required in production because public RLS access is revoked.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser access is disabled by default. Comma-separated exact origins only.
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,your-api.example.com

# Ingestion safety
INGEST_ALLOWED_HOSTS=cdn.discordapp.com,media.discordapp.net
INGEST_MAX_ATTACHMENTS=5
INGEST_MAX_FILE_BYTES=20971520
INGEST_MAX_TOTAL_CHARS=2000000
INGEST_DOWNLOAD_TIMEOUT_SECONDS=30
INGEST_MAX_PDF_PAGES=1000

# Optional OCR and reranking providers
MISTRAL_API_KEY=
COHERE_API_KEY=

# RAG behavior
HISTORY_ENABLED=true
# Required with history in production. Keep stable; rotate only with a migration plan.
USER_ID_SALT=
HISTORY_RETENTION_DAYS=90
SCORE_THRESHOLD=0.30
MAX_CHUNKS=10

# Jev / TypeSafe: disabled by default; configure key locally, never commit it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
RERANK_PROVIDER=openai
RERANK_FULL_CONTEXT=false
TYPESAFE_RERANK_SHADOW=false
TYPESAFE_VERIFY_MODE=off
TYPESAFE_HTTP_TIMEOUT_SECONDS=3
TYPESAFE_STAGE_DEADLINE_SECONDS=10
TYPESAFE_MAX_RETRIES=1
TYPESAFE_MAX_CONCURRENCY=4
TYPESAFE_MAX_CANDIDATES=15
TYPESAFE_MAX_CHUNK_CHARS=6000
TYPESAFE_MAX_REQUEST_BYTES=24000
# Rolling 30-day per-process budget; resets on restart, not an account spending cap.
TYPESAFE_BUDGET_USD=1
# Pilot thresholds; enforcement requires human-reviewed calibration.
TYPESAFE_SUPPORT_THRESHOLD=0.9
TYPESAFE_CONTRADICTION_THRESHOLD=0.1
TYPESAFE_CRITERIA_VERSION=pilot-v2-specific-rubrics
TYPESAFE_CRITERIA_CALIBRATED=false

# Optional observability. PII remains disabled in code.
SENTRY_DSN=
RELEASE_VERSION=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
